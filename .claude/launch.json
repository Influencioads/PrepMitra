{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "prepmitra-api",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": ["backend/scripts/dev_server.py", "--port", "8001"],
      "port": 8001
    },
    {
      "name": "prepmitra-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:web"],
      "port": 5173
    },
    {
      "name": "question-bank-viewer",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8765", "--bind", "127.0.0.1", "--directory", "docs/question-bank"],
      "port": 8765,
      "autoPort": false
    },
    {
      "name": "prepmitra-web-3000",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:web", "--", "--port", "3000", "--strictPort"],
      "port": 3000
    }
  ]
}
