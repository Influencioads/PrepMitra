# Copy to .env (or .env.local) in apps/mobile. EXPO_PUBLIC_* values are inlined
# into the app bundle at build time — never put secrets here.

# Base URL of the future PrepMitra /v1 backend.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# "true" (default) uses the on-device mock services and seeded demo data.
# Set to "false" only when a backend implementing /v1 is running.
EXPO_PUBLIC_USE_MOCK_API=true
