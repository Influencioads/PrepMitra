# Base URL of the PrepMitra backend API (/v1 routes). Leave as-is for the prototype.
VITE_API_BASE_URL=http://localhost:8080
# true = use in-browser mock services (default). Set to false once the backend is live.
VITE_USE_MOCK_API=true
# Never put secret keys here — everything prefixed VITE_ is shipped to the browser.

# --- Auth -------------------------------------------------------------------
# demo (default) = built-in demo OTP flow. firebase = Firebase Phone OTP + Google sign-in.
VITE_AUTH_PROVIDER=demo
# Firebase web config (public identifiers, not secrets). Only read when VITE_AUTH_PROVIDER=firebase.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# --- Payments ---------------------------------------------------------------
# Razorpay *Key ID* only (rzp_test_… / rzp_live_…). The Key Secret stays on the server.
# Only used when VITE_USE_MOCK_API=false.
VITE_RAZORPAY_KEY_ID=

# --- Pricing ----------------------------------------------------------------
# full = Free / Pay-per-mock / Monthly / Quarterly. launch = Free / Pay-per-mock / 10-credit pack (₹399).
VITE_PRICING_SET=full

# --- Monitoring -------------------------------------------------------------
# Sentry DSN (public). Leave empty to disable error reporting — the SDK is not loaded at all.
VITE_SENTRY_DSN=
# true = log analytics events to the browser console in production builds too.
VITE_ANALYTICS_DEBUG=false
