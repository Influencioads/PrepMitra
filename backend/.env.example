# Copy to .env (never commit .env). Values below are safe placeholders.

APP_NAME=PrepMitra AI
# development | test | production. In development the OTP is returned in the API response.
APP_ENV=development
# Comma-separated web origins allowed by CORS (mobile apps do not need CORS).
CORS_ORIGINS=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:5173

DATABASE_URL=postgresql+psycopg://prepmitra:prepmitra@localhost:5432/prepmitra
# Optional: run the test suite against Postgres instead of the default throwaway SQLite DB.
TEST_DATABASE_URL=postgresql+psycopg://prepmitra:prepmitra@localhost:5432/prepmitra_test

# Redis: job queue, rate limits, catalog cache. Leave empty for a single-process dev setup.
REDIS_URL=
# eager (tests) | thread (single-process dev) | redis (production: run `python -m app.worker`)
JOB_MODE=thread
# true in dev; false in production where the worker runs the scheduler
RUN_SCHEDULER_IN_API=true

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# This phone becomes a founder admin on first login (bootstrap only).
BOOTSTRAP_ADMIN_PHONE=

# Firebase Authentication (15-day plan): phone OTP + Google on the client; the backend verifies Firebase ID tokens.
FIREBASE_PROJECT_ID=

# Google sign-in without Firebase (optional): web OAuth client ID, plus Android/iOS client IDs (comma separated). Empty = disabled.
GOOGLE_CLIENT_ID=
GOOGLE_EXTRA_CLIENT_IDS=

# AI. AI_PROVIDER=mock is deterministic and free (tests/demo, no key needed).
# AI_PROVIDER=claude uses the Anthropic API and needs ANTHROPIC_API_KEY.
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
AI_MODEL_STRONG=claude-opus-5-5
AI_MODEL_FAST=claude-haiku-5-5

# Voice interviews: only the mock speech adapter exists today (see docs/REQUIREMENTS_STATUS.md).
SPEECH_PROVIDER=mock

# Notifications: email console (dev) | smtp (e.g. Amazon SES SMTP) | resend; push console | fcm
EMAIL_PROVIDER=console
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=PrepMitra AI <no-reply@prepmitra.local>
PUSH_PROVIDER=console
# Firebase service-account JSON (Firebase console > Project settings > Service accounts). Keep it in backend/secrets/ (gitignored).
FCM_CREDENTIALS_FILE=

# Monitoring
SENTRY_DSN=
# Only for load tests on staging (all simulated users share one IP). Keep true everywhere else.
RATE_LIMITS_ENABLED=true

STORAGE_DIR=storage
# Put Noto *.ttf fonts here for Indic-script PDFs
FONTS_DIR=fonts

# Payments. Without Razorpay keys (or with PAYMENT_GATEWAY=mock) a mock gateway is used.
# Use Razorpay TEST-MODE keys only until production launch checks are complete.
PAYMENT_GATEWAY=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
GST_RATE_PERCENT=18
GSTIN=
COMPANY_LEGAL_NAME=

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000/v1
VITE_GOOGLE_CLIENT_ID=
