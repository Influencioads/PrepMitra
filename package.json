{
  "name": "prepmitra-ai",
  "private": true,
  "version": "0.1.0",
  "description": "PrepMitra AI \u2014 AI mock exam and mock interview platform (frontend monorepo)",
  "workspaces": [
    "frontend",
    "app",
    "shared"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @prepmitra/web",
    "build:web": "npm run build --workspace @prepmitra/web",
    "test:web": "npm run test --workspace @prepmitra/web",
    "test:shared": "npm run test --workspace @prepmitra/shared",
    "test": "npm run test:shared && npm run test:web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "start:mobile": "npm run start --workspace @prepmitra/mobile",
    "lint": "npm run lint --workspace @prepmitra/web",
    "ci": "npm run lint && npm run typecheck && npm test && npm run build:web"
  },
  "engines": {
    "node": ">=20.19"
  }
}
